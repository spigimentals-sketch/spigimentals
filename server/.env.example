PORT=3000
JWT_SECRET=replace-with-a-long-random-string

# Cloudinary — required for uploads (audio, cover art, sample packs) to work.
# Free account at https://cloudinary.com — these three values are on your
# Cloudinary dashboard home page after signup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Turso (hosted SQLite) — required in production so the database survives
# redeploys on hosts with no persistent disk (e.g. Render's free tier).
# Free account at https://turso.tech. Leave both unset for local dev — the
# app then falls back to a local libSQL file at server/data/spigimentals.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
